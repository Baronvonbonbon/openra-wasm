<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-browser</TargetFramework>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<OutputType>Exe</OutputType>
		<RootNamespace>OpenRA.Web</RootNamespace>
		<AssemblyName>OpenRA.Web</AssemblyName>
		<OutputPath>$(EngineRootPath)/bin-web</OutputPath>
		<WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>

		<!-- Gate A: prove the runtime boots and OpenRA assemblies load.
		     Trimming is deliberately OFF - OpenRA's ObjectCreator/FieldLoader are
		     heavily reflective and will need ILLink descriptors before this can be enabled. -->
		<PublishTrimmed>false</PublishTrimmed>
		<!-- Fluent localisation resolves real cultures, which invariant mode rejects. -->
		<InvariantGlobalization>false</InvariantGlobalization>
		<WasmEnableSIMD>true</WasmEnableSIMD>

		<!-- Emscripten defaults to MAX_WEBGL_VERSION=1, which silently downgrades a
		     WebGL2 context request to WebGL1. OpenRA's Embedded GL profile targets
		     OpenGL ES 3.0 (#version 300 es), which requires WebGL2. -->
		<EmccExtraLDFlags>-s MAX_WEBGL_VERSION=2</EmccExtraLDFlags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" />
		<ProjectReference Include="..\OpenRA.Platforms.Web\OpenRA.Platforms.Web.csproj" />

		<!-- The mod manifests list these in Assemblies:. Under wasm there is no bin
		     directory to load them from, so they are published with the app. -->
		<ProjectReference Include="..\OpenRA.Mods.Common\OpenRA.Mods.Common.csproj" />
		<ProjectReference Include="..\OpenRA.Mods.Cnc\OpenRA.Mods.Cnc.csproj" />

		<!-- Eluant binds native lua51, which does not exist in the browser. The shim
		     carries Eluant's assembly identity and is swapped into the bundle by the
		     SubstituteEluant target below. ReferenceOutputAssembly is off so it builds
		     without competing with the real package during reference resolution;
		     compile-time references still come from the package via OpenRA.Game.
		     MoonSharp backs the shim and so has to be bundled alongside it. -->
		<ProjectReference Include="..\OpenRA.Eluant.MoonSharp\OpenRA.Eluant.MoonSharp.csproj"
		                  ReferenceOutputAssembly="false" />
		<PackageReference Include="MoonSharp" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<WasmExtraFilesToDeploy Include="wwwroot/index.html" />
	</ItemGroup>

	<!-- The SDK collects assemblies to bundle from ReferenceCopyLocalPaths in
	     _GetDefaultWasmAssembliesToBundle. Replacing the entry there is what makes the
	     browser build use the MoonSharp-backed Eluant instead of the native-backed one;
	     desktop is untouched because this target lives in the web app project. -->
	<Target Name="SubstituteEluant" AfterTargets="_GetDefaultWasmAssembliesToBundle">
		<ItemGroup>
			<WasmAssembliesToBundle Remove="@(WasmAssembliesToBundle)"
			                        Condition="'%(Filename)' == 'Eluant'" />
			<WasmAssembliesToBundle Include="$(EngineRootPath)/bin-web/eluant/Eluant.dll" />
		</ItemGroup>
	</Target>

	<!-- Native sources are linked by the app project, not by referenced libraries,
	     so the platform's WebGL shim has to be listed here. -->
	<ItemGroup>
		<NativeFileReference Include="../OpenRA.Platforms.Web/native/webgl_shim.c" />

		<!-- Built by packaging/web/build-freetype.sh. The file name matters: .NET
		     derives the P/Invoke module name from it, and FreeTypeFont.cs imports
		     "freetype6". -->
		<NativeFileReference Include="../OpenRA.Platforms.Web/native/freetype/freetype6.a" />
	</ItemGroup>


	<!-- The SDK's deploy of wwwroot content is incremental and does not reliably
	     re-copy edited files, which silently serves a stale page. Copy them
	     unconditionally instead, after the app bundle is generated: a native relink
	     recreates that directory and would otherwise discard these files. -->
	<Target Name="CopyWebAssets" AfterTargets="WasmGenerateAppBundle">
		<ItemGroup>
			<WebAsset Include="wwwroot/**/*" />
		</ItemGroup>
		<Copy SourceFiles="@(WebAsset)"
		      DestinationFolder="$(OutputPath)AppBundle/%(RecursiveDir)"
		      SkipUnchangedFiles="false" />
	</Target>

	<!-- The engine reads shader sources from EngineDir/glsl at runtime. They are
	     served alongside the bundle so the page can fetch them into the virtual
	     filesystem. -->
	<Target Name="CopyEngineFiles" AfterTargets="WasmGenerateAppBundle">
		<ItemGroup>
			<ShaderSource Include="$(EngineRootPath)/glsl/**/*" />
			<FontSource Include="$(EngineRootPath)/mods/common/*.ttf" />
		</ItemGroup>
		<Copy SourceFiles="@(ShaderSource)"
		      DestinationFolder="$(OutputPath)AppBundle/engine/glsl/%(RecursiveDir)"
		      SkipUnchangedFiles="false" />
		<Copy SourceFiles="@(FontSource)"
		      DestinationFolder="$(OutputPath)AppBundle/engine/mods/common/"
		      SkipUnchangedFiles="false" />
	</Target>
</Project>
